# Base URL for a future HTTP catalog API (no trailing slash).
# Leave empty while mock data is enabled. Example: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=

# When "true" (default), product services use in-repo mock data.
# Set to "false" only after a real API is available and NEXT_PUBLIC_API_BASE_URL is set.
NEXT_PUBLIC_USE_MOCK_API=true

# ── Figma MCP ──────────────────────────────────────────────────────────────────
# Optional: paste your Figma project/file URL here so team tooling and scripts
# can reference the canonical design source.  Authentication is handled via
# OAuth inside your IDE (no token needed here).
# Example: https://www.figma.com/design/XXXXXXXXXXXXXXXX/My-Project
FIGMA_FILE_URL=
